### Unity ###
# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
/TurnZero/[Ll]ibrary/
/TurnZero/[Tt]emp/
/TurnZero/[Oo]bj/
/TurnZero/[Bb]uild/
/TurnZero/[Bb]uilds/
/TurnZero/[Ll]ogs/
/TurnZero/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/TurnZero/[Mm]emoryCaptures/

# Recordings can get excessive in size
/TurnZero/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /TurnZero/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/TurnZero/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/TurnZero/.vs/

# Gradle cache directory
/TurnZero/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/TurnZero/ExportedObj/
/TurnZero/.consulo/
/TurnZero/*.csproj
/TurnZero/*.unityproj
/TurnZero/*.sln
/TurnZero/*.slnx
/TurnZero/*.suo
/TurnZero/*.tmp
/TurnZero/*.user
/TurnZero/*.userprefs
/TurnZero/*.pidb
/TurnZero/*.booproj
/TurnZero/*.svd
/TurnZero/*.pdb
/TurnZero/*.mdb
/TurnZero/*.opendb
/TurnZero/*.VC.db

# Unity3D generated meta files
/TurnZero/*.pidb.meta
/TurnZero/*.pdb.meta
/TurnZero/*.mdb.meta

# Unity3D generated file on crash reports
/TurnZero/sysinfo.txt

# Builds
/TurnZero/*.apk
/TurnZero/*.aab
/TurnZero/*.unitypackage
/TurnZero/*.app

# Crashlytics generated file
/TurnZero/crashlytics-build.properties

# Packed Addressables
/TurnZero/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/TurnZero/[Aa]ssets/[Ss]treamingAssets/aa.meta
/TurnZero/[Aa]ssets/[Ss]treamingAssets/aa/*

### VisualStudioCode ###
/TurnZero/.vscode/*
!/TurnZero/.vscode/settings.json
!/TurnZero/.vscode/tasks.json
!/TurnZero/.vscode/launch.json
!/TurnZero/.vscode/extensions.json
!/TurnZero/.vscode/*.code-snippets

# Local History for Visual Studio Code
/TurnZero/.history/

# Built Visual Studio Code Extensions
/TurnZero/*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
/TurnZero/.history
/TurnZero/.ionide

# End of https://www.toptal.com/developers/gitignore/api/unity,visualstudiocode
